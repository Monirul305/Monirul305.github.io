{% assign repo_path = include.repository.repo %}
{% assign parts = repo_path | split: '/' %}
{% assign owner = parts[0] %}
{% assign name = parts[1] %}

<div class="repo p-2">
  <a href="https://github.com/{{ repo_path }}" target="_blank" rel="noopener external" class="repo-card-link">
    <div class="repo-card">
      <div class="repo-card-header">
        <i class="fa-brands fa-github"></i>
        <span class="repo-card-name">{{ name }}</span>
      </div>
      {% if include.repository.description %}
        <p class="repo-card-description">{{ include.repository.description }}</p>
      {% endif %}
      <div class="repo-card-footer">
        <span class="repo-card-owner">@{{ owner }}</span>
        <span class="repo-card-cta">View on GitHub <i class="fa-solid fa-arrow-up-right-from-square"></i></span>
      </div>
    </div>
  </a>
</div>
