<div class="repo p-2">
  <a href="https://github.com/{{ include.username }}" target="_blank" rel="noopener external" class="repo-card-link">
    <div class="repo-card repo-user-card">
      <img
        class="repo-user-avatar"
        src="https://github.com/{{ include.username }}.png?size=160"
        alt="{{ include.username }}"
        width="80"
        height="80"
      >
      <div class="repo-user-info">
        <div class="repo-user-name">
          <i class="fa-brands fa-github"></i>
          <strong>@{{ include.username }}</strong>
        </div>
        <span class="repo-card-cta">View profile <i class="fa-solid fa-arrow-up-right-from-square"></i></span>
      </div>
    </div>
  </a>
</div>
