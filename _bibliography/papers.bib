@article{islam2026agvfleet,
  title        = {Peer-Aware Distributed Path Planning for a Production-Deployed Multi-{AGV} Fleet in a Human-Occupied Garment Factory},
  author       = {Islam, Md Monirul and Islam, Mainul and Saumik, Emon Hasan},
  journal      = {In Preparation},
  year         = {2026},
  abbr         = {In Prep},
  status       = {InPrep},
  selected     = {false},
  additional_info = { (first / corresponding author — manuscript in preparation)},
  abstract     = {
    Reports on a fully decentralized path-planning and coordination scheme
    deployed on a 3-robot AGV fleet operating continuously inside a live garment
    factory alongside hundreds of human workers, with no physical separation.
    Each robot runs its own A* planner over a shared occupancy grid and
    publishes the resulting plan as a sequence of timestamped grid waypoints;
    every other robot subscribes and treats the peer trajectories as
    spatiotemporal reservations subject to three conflict checks — node
    conflict, edge swap, and final-cell occupation. A continuous
    timestamp-maintenance step keeps published ETAs realistic between
    re-planning events so peer reservations remain meaningful in steady state.
    Obstacles are handled without dropping the active plan: the old
    timestamped path keeps publishing while the planner searches for a clean
    replacement, preserving a coherent fleet-wide picture until a safe swap is
    available. Combined with a fail-closed coordinator providing FSM-based
    state tracking, mutual exclusion on shared resources, and layered
    timeouts, the system has accumulated months of zero-collision production
    operation. The paper reports the coordination protocol, the deployment
    case study, and quantitative throughput / recovery measurements collected
    on the factory floor.
  }
}

@article{islam2025gapid,
  title        = {Speed Synchronization of a Dual-{BLDC} Tracked Differential-Drive Vehicle Using a {GA}-Tuned Multi-Rate Cross-Coupled Controller},
  author       = {Islam, Md Monirul and Islam, Mainul and Tanvir, Md Shakil},
  journal      = {Under Review},
  year         = {2026},
  abbr         = {Submitted},
  status       = {Submitted},
  selected     = {false},
  additional_info = { (first / corresponding author)},
  abstract     = {
    Distributed dual-MCU realization of bilateral cross-coupled speed
    synchronization for a 120 kg tracked skid-steer vehicle driven by two
    mismatched three-phase BLDC "auto-rickshaw" motors, evaluated on the
    assembled vehicle. Each motor runs a local PID with per-motor feedforward
    on its own STM32; a bilateral cross-coupled term, exchanged over a
    dedicated 1 ms inter-MCU link and updated at 1 kHz against 200 Hz
    per-motor loops, drives the inter-motor speed difference toward zero, with
    speed feedback a tracking-observer estimate from a 12-bit capacitive
    absolute encoder. Every feedback and feedforward gain is tuned online by a
    two-stage genetic algorithm — the per-motor loops off-ground, then the
    coupling against the operating differential — because the inter-drive
    mechanical mismatch (belt tension, running-gear friction, terrain) cannot
    be modeled beforehand. Over three tuning seeds on out-of-training operating
    points, synchronization cuts the inter-motor error by 41 % in
    clean-tracking RMSE (10.67 to 6.26 rpm) and 65 % under an 80 kg one-sided
    load (24.9 to 8.7 rpm) versus an independently tuned independent-drive
    baseline. A same-plant comparison against conventional single-rate
    cross-coupling and an equally tuned linear active-disturbance-rejection
    baseline isolates the central finding: the 1 kHz multi-rate loop is the
    performance lever, its useful rate bounded by the speed-estimate
    bandwidth, and the transparent PID has the lowest error of every arm — on
    commodity microcontrollers.
  }
}

@article{tanvir2025dual,
  title        = {A Dual-Network Feedback Communication System for Multi-Node Unmanned Robotic Control},
  author       = {Tanvir, Md Shakil and Islam, Md Monirul and Tonmoy, Fiaz Ahmed and Islam, Mainul},
  journal      = {Under Review},
  year         = {2026},
  abbr         = {Submitted},
  status       = {Submitted},
  selected     = {false},
  additional_info = { (co-author)},
  abstract     = {
    Field-deployed multi-node unmanned robotic platforms rely on continuous
    feedback exchange between control nodes — sensor readings, drive-state
    telemetry, watchdog liveness. When that exchange traverses a single
    network, any link failure (wiring damage, connector fatigue, RF
    interference) silently degrades coordination and becomes a single point of
    failure for the whole platform. This paper proposes a fault-tolerant
    dual-network feedback communication architecture in which two physically
    and electrically independent feedback networks carry the same coordination
    stream in parallel between every node. The receiver continuously monitors
    per-channel health and falls back to the surviving network on degradation
    without losing a control cycle, while the master node logs the event for
    post-mission diagnostics. The architecture is targeted at unmanned
    multi-node robotic platforms operating in environments where any single
    wired or RF link can drop intermittently, and is validated on a
    multi-DOF unmanned ROV with deliberately injected single-channel faults.
  }
}
